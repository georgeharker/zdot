#!/usr/bin/env zsh
# Shared inject router for one template → one output. THE single place the
# plain `op inject` line lives — both secrets (refresh_shell_secrets) and
# mcp (refresh_mcpservers_secret) consumers call this, so neither has to
# know the auth mode or the template shape.
#
# Routing:
#   - Account-TAGGED refs (op-<acct>://…) → op_multi_inject: multi-account,
#     one piped inject pass per tag, all-or-nothing. Works under a signed-in
#     session in login mode (SA-mode machines should keep plain refs — the
#     SA token binds op to a single account).
#   - Plain refs (op://…) → plain `op inject --force` against the
#     single/default account (service-account mode and one-account machines).
#   - ':zdot:secrets:op default-account' (zstyle) is read HERE — it feeds
#     op_multi_inject's raw-ref pass; unset is fine for tag-only templates.
#
# Never sources the output (env templates are sourced by the caller, JSON
# configs are consumed from disk). rc 0 written, else 1 — callers own the
# user-facing error text.
#
# Usage: op_inject_template <template> <out-file>

function op_inject_template {
    local template=$1 out_file=$2
    [[ -f "$template" ]] || return 1

    if grep -qE 'op-[A-Za-z0-9._-]+://' "$template"; then
        local -a m_args=(-i "$template" -o "$out_file")
        local default_account
        zstyle -s ':zdot:secrets:op' default-account default_account
        [[ -n "$default_account" ]] && m_args+=(--default-account "$default_account")
        op_multi_inject "${(@)m_args}"
        return $?
    fi

    # Plain single/default-account template — direct inject
    _op inject --force --in-file "$template" --out-file "$out_file"
}
