#!/usr/bin/env zsh
# Shared inject router for one template → one output. THE single place the
# plain `op inject` line lives — both secrets (refresh_shell_secrets) and
# mcp (refresh_mcpservers_secret) consumers call this, so neither has to
# know the auth mode or the template shape.
#
# Routing:
#   - Account-TAGGED refs (op-<acct>://…) → op_multi_inject: multi-account,
#     one piped inject pass per tag, all-or-nothing. Works under a signed-in
#     session in login mode (SA-mode machines should keep plain refs — the
#     SA token binds op to a single account).
#   - ':zdot:secrets:op default-account' set → op_multi_inject as well, even
#     for an untagged template: its plain op:// refs must name that account
#     (a bare inject can't choose once more than one account is signed in).
#     The zstyle is read HERE and passed as --default-account.
#   - Untagged template, no default-account → plain `op inject --force`
#     (service-account mode and one-account machines).
#
# Never sources the output (env templates are sourced by the caller, JSON
# configs are consumed from disk). rc 0 written, else 1 — callers own the
# user-facing error text.
#
# Inject, then check the RESULT before it replaces anything: the inject
# writes <out-file>.tmp beside the output (same directory; the inject
# creates it, as it would <out-file>), op_check_template checks it (refs op
# left unresolved, JSON validity for a .json template; messages name the
# template), then:
#   - clean          → mv over <out-file>; <out-file>.failed removed
#   - check failed   → mv to <out-file>.failed (the bad output, kept for
#                      inspection; it also marks the failure)
#   - inject failed  → <out-file>.tmp removed, <out-file>.failed touched
# Either failure leaves the last good <out-file> in place.
# _op_template_needs_refresh (secrets.zsh) reads the marker so an unchanged
# broken template isn't retried automatically in every new tab. Callers
# establish the session first (_op_require_session).
#
# Usage: op_inject_template <template> <out-file>

function op_inject_template {
    local template=$1 out_file=$2
    [[ -f "$template" ]] || return 1
    local tmp_out="${out_file}.tmp"

    local -i ok=0
    local default_account op_output
    zstyle -s ':zdot:secrets:op' default-account default_account
    if [[ -n "$default_account" ]] || grep -qE 'op-[A-Za-z0-9._-]+://' "$template"; then
        local -a m_args=(-i "$template" -o "$tmp_out")
        [[ -n "$default_account" ]] && m_args+=(--default-account "$default_account")
        op_multi_inject "${(@)m_args}" && ok=1
    else
        # Untagged template, single account — direct inject. Capture op's
        # chat (it prints the --out-file path on success) and discard it on
        # success; re-surface it via zdot_* on failure. The pre-refactor
        # refresher's pattern (op_output=$(op … 2>&1) → zdot_error on
        # rc≠0), now that the plain inject line lives here for ALL callers.
        if op_output=$(_op inject --force --in-file "$template" --out-file "$tmp_out" 2>&1); then
            ok=1
        else
            zdot_warn "op_inject_template: failed to resolve $template"
            [[ -n "$op_output" ]] && zdot_error "op_inject_template: $op_output"
        fi
    fi

    if (( ! ok )); then
        rm -f -- "$tmp_out"                 # a partial inject, if any
        touch -- "${out_file}.failed"
        return 1
    fi
    if ! op_check_template "$tmp_out" "$template"; then
        mv -f -- "$tmp_out" "${out_file}.failed"
        return 1
    fi
    mv -f -- "$tmp_out" "$out_file" || return 1
    rm -f -- "${out_file}.failed"
    return 0
}

