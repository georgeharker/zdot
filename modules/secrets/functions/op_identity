#!/usr/bin/env zsh
# Establish this machine's 1Password identity — the layer between signing
# a person in (op_auth) and rebuilding derived secrets (refresh_shell_secrets,
# the mcp refresher). What the identity is depends on the auth mode
# (zstyle ':zdot:secrets:op' mode):
#   service-account     — the host's service-account token, good for the
#                         whole session: create or choose the account, write
#                         its template, inject the token cache; see
#                         _op_identity_service_account
#   login / lazy-login  — the signed-in account sessions: check each account,
#                         sign in the rest; see _op_identity_login
# Interactive shells may prompt; noninteractive ones never do. (op_refresh
# is the old name and still works.) Sets _ZDOT_OP_ACTIVE; returns 0 when the
# identity is usable.

function op_identity {
    local mode
    _op_get_mode && mode=$REPLY
    if [[ "$mode" == login || "$mode" == lazy-login ]]; then
        _op_identity_login
    else
        _op_identity_service_account
    fi
}

# op_identity, login-mode half. In login mode the machine's 1Password
# credential IS the set of signed-in account sessions, so keeping it current
# means: check each configured account (the check self-heals headlessly),
# have op_auth sign in whatever is still signed out (interactive shells
# only — elsewhere just report failure), then confirm each account.
# Touches none of the service-account machinery. Sets _ZDOT_OP_ACTIVE;
# returns 0 when every configured account is signed in, else 1.
_op_identity_login() {
    if _op_login_check; then
        _op_login_feedback
        return 0
    fi
    [[ $_ZDOT_IS_INTERACTIVE -eq 1 ]] || return 1
    op_auth || true
    _op_login_check || return 1
    _op_login_feedback
}

# op_identity, service-account half. The machine's credential is a service-
# account token: sign the human in (op_auth), create or choose the host's
# service account (interactive), write the op-secrets.zsh template, inject
# it into the token cache, then sign the human out. Noninteractive shells
# only re-inject from an existing template. Sets _ZDOT_OP_ACTIVE; returns 0
# when the token cache was (re)built.
_op_identity_service_account() {
    # Secrets environment — one resolver, named keys (see secrets.zsh)
    typeset -A _se
    _op_get_secrets_env && _se=("${reply[@]}")
    local secrets_src_dir="${_se[src_dir]}" secrets_cache="${_se[cache]}"
    [[ ! -d "${secrets_cache}" ]] && mkdir -p "${secrets_cache}"

    # Get op config
    local op_config_dir
    op_config_dir=$(op_get_config_dir)

    # Read vault configuration from zstyle (set in secrets-configure group):
    # scalars via op_get_vault_config, the grant ARRAY via op_get_vault_grants
    # (whose derived default needs the resolved vault names — hence the args).
    typeset -A _v
    op_get_vault_config && _v=("${reply[@]}")
    local op_svc_vault="${_v[svc]}" op_api_vault="${_v[api]}" op_ssh_vault="${_v[ssh]}"
    local -a op_svc_grants
    op_get_vault_grants "$op_api_vault" "$op_ssh_vault" && op_svc_grants=("${reply[@]}")

    # Clear existing token
    typeset +x OP_SERVICE_ACCOUNT_TOKEN
    rm -f "${secrets_cache}/${USER}.op-secrets.zsh"

    # Check if no_op flag is set
    if [[ -f "${op_config_dir}/no_op" ]]; then
        _ZDOT_OP_ACTIVE=0
        return 1
    fi

    # In interactive mode, try to authenticate if not configured
    if [[ $_ZDOT_IS_INTERACTIVE -eq 1 ]]; then
        # Sign a person in (will prompt if needed): creating or choosing the
        # service account needs one
        if ! _op_auth_person; then
            _ZDOT_OP_ACTIVE=0
            return 1
        fi
    fi

    # In noninteractive mode, check if config exists
    if [[ $_ZDOT_IS_INTERACTIVE -ne 1 ]]; then
        if [[ ! -f "${op_config_dir}/config" ]]; then
            _ZDOT_OP_ACTIVE=0
            return 1
        fi
        # Verify we're signed in (without prompting)
        if ! _op_logged_in; then
            _ZDOT_OP_ACTIVE=0
            return 1
        fi
    fi

    # If we reach here, authentication is successful
    # Now handle service account setup/refresh

    local host_service_account="$(hostname)-service-account"

    # Interactive mode: offer to create new service account
    if [[ $_ZDOT_IS_INTERACTIVE -eq 1 ]]; then
        echo "Using 1Password to refresh service account"
        
        local new_svc_acct=0
        printf "Create new service-account? [Y/n/c] "
        read -r -k 1 option
        [[ "$option" = $'\n' ]] || echo
        case "$option" in
            [yY$'\n']) new_svc_acct=1 ;;
            [nN]) new_svc_acct=0 ;;
            *)
                echo "You will be asked at next login"
                _ZDOT_OP_ACTIVE=0
                return 1
                ;;
        esac

        if [[ $new_svc_acct -eq 1 ]]; then
            # Build --vault grant flags from config
            local -a grant_flags
            local grant
            for grant in "${op_svc_grants[@]}"; do
                grant_flags+=(--vault "$grant")
            done
            # NOTE: plain `local svc_acct_output=$(… | grep …)` would swallow
            # the pipeline's rc into `local` (zsh: local always exits 0), so the
            # grep-empty case took the success path — declare first, then test
            # the bare assignment, whose status is the substitution's.
            local svc_acct_output
            if svc_acct_output=$(_op service-account create "$host_service_account" --can-create-vaults \
                                        "${grant_flags[@]}" 2>&1 | grep "export OP_SERVICE_ACCOUNT_TOKEN="); then
                local acct_key=$(eval "$svc_acct_output"; echo $OP_SERVICE_ACCOUNT_TOKEN)
                _op item create --vault "$op_svc_vault" \
                                --category "API Credential" \
                                --title "$host_service_account" - \
                                "credential=$acct_key" \
                                "validFrom[string]=" \
                                "expires[string]=" \
                                "host=$(hostname)" > /dev/null
                mkdir -p "${secrets_src_dir}"
                echo "export OP_SERVICE_ACCOUNT_TOKEN=op://${op_svc_vault}/${host_service_account}/credential" > "${secrets_src_dir}/op-secrets.zsh"
            else
                echo "Failed to create service account"
                _ZDOT_OP_ACTIVE=0
                return 1
            fi
        else
            # Offer to choose existing account
            printf "Accounts:\n"
            _op item list --vault "$op_svc_vault"
            printf "Choose account name: "
            read -r name
            mkdir -p "${secrets_src_dir}"
            echo "export OP_SERVICE_ACCOUNT_TOKEN=op://${op_svc_vault}/${name}/credential" > "${secrets_src_dir}/op-secrets.zsh"
        fi
    fi

    # Inject secrets (both interactive and noninteractive)
    if [[ -f "${secrets_src_dir}/op-secrets.zsh" ]]; then
        if _op inject --force --in-file "${secrets_src_dir}/op-secrets.zsh" --out-file "${secrets_cache}/${USER}.op-secrets.zsh" > /dev/null; then
            # Sign out if in interactive mode
            [[ $_ZDOT_IS_INTERACTIVE -eq 1 ]] && _op signout
            _ZDOT_OP_ACTIVE=1
            return 0
        else
            echo "Failed to refresh 1Password service account"
            _ZDOT_OP_ACTIVE=0
            return 1
        fi
    else
        # No source file exists
        _ZDOT_OP_ACTIVE=0
        return 1
    fi
}

# This file holds more than its own function, so zsh treats the whole file
# as op_identity's body on first call: running it defines everything above,
# and this line then runs the real op_identity. Later calls go straight to
# the definitions. Without it the first call would silently do nothing.
op_identity "$@"
