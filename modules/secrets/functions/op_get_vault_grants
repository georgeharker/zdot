#!/usr/bin/env zsh
# Read the service-account grant list from zstyle into $reply (an array).
#
# Split out of op_get_vault_config so each return owns ONE channel: this one is
# the array (vault:permissions strings granted to newly created service
# accounts). Its default is DERIVED from the resolved api/ssh vault names, so
# they are passed in explicitly — the entanglement of the old single-function
# return is now a visible argument instead of hidden shared state.
#
# Usage: op_get_vault_grants <api-vault> <ssh-vault>
# zstyle (set in a secrets-configure group hook; overrides the derived default):
#   zstyle ':zdot:secrets:op' service-acct-grants \
#       'API:read_items,write_items' \
#       'SSHKeys:read_items,write_items'
#
# Consumer:
#   local -a op_svc_grants
#   op_get_vault_grants "$op_api_vault" "$op_ssh_vault" && op_svc_grants=("${reply[@]}")

function op_get_vault_grants {
    local op_api_vault="$1" op_ssh_vault="$2"
    zstyle -a ':zdot:secrets:op' service-acct-grants reply && return 0
    # Derived default (each vault gets read+write; op deduplicates identical grants)
    reply=(
        "${op_api_vault}:read_items,write_items"
        "${op_ssh_vault}:read_items,write_items"
    )
}