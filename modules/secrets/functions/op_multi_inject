#!/usr/bin/env zsh
# Multi-account template resolver for 1Password — an `op inject` work-alike.
#
# Usage (close to `op inject`):
#   op_multi_inject [-i|--input_file|-–input-file <file>]   # else stdin
#                   [-o|--output_file|--output-file <file>] # else stdout
#                   [--default-account <acct>]              # raw op:// refs
#                   [--account <acct>]...                   # explicit passes
#                   [--force] [--] [<op arg>...]            # e.g. --config dir
#
# Replacement directives (argparse — no zstyle reads here; the zstyle wrapper
# resolves config and forwards them):
#   --default-account <acct> — account for RAW op:// refs. Raw refs without
#       it → error: they would otherwise bind to whichever account injects
#       first. With a default configured, the first pass is a plain inject
#       against it: raw refs resolve there, tagged refs pass
#       through untouched (and if the input has no raw refs at all, the
#       stage is skipped — output would equal input anyway).
#   --account <acct> (repeatable) — explicit pass list, order verbatim;
#       overrides tag derivation.
# Unknown options/operands pass through verbatim to every op invocation.
#
# THE PASSES — one per account: sed the tag, then inject with that account
#   1–2 passes: one pipeline, nothing held between passes
#     input | sed -e 's@op-<a1>://@op://@g' | op inject --account a1 \
#           | sed -e 's@op-<a2>://@op://@g' | op inject --account a2
#   3+ passes: a loop, each pass a $( ) over the previous result
# Without --account, accounts derive from the TAGS in the input (op-<acct>://
# refs; op:// URIs carry no account segment and bare op commands FAIL when
# more than one account is available). No temp files, and pass order is
# irrelevant: resolved values are no longer refs, so later passes cannot
# re-resolve them.
#
# Semantics: all-or-nothing — every pass account must be signed in (`op
# whoami --account` pre-check); one missing → error, nothing written. A
# failing pass is named: directly for 1 pass and in the loop; a 2-pass
# pipeline failure re-runs through the loop to find which.
# Never sources its output — safe for env templates and machine configs
# (mcp JSON…) alike.
#
# rc 0 (input resolved; -o written or stdout printed) else 1.

function op_multi_inject {
    setopt local_options pipefail

    # Helpers: defined per call and removed again on every return path (the
    # always block). They read this function's locals — in_file, content,
    # stage_*, passthrough, force — so they mean nothing outside it.

    # The input, as a stream: the -i file, or the stdin content already read.
    _op_multi_inject_input() {
        if [[ -n "$in_file" ]]; then
            cat "$in_file"
        else
            print -rn -- "$content"
        fi
    }

    # Pass <i>, stdin → stdout: [sed op-<acct>:// → op://] | op inject --account.
    _op_multi_inject_pass() {
        local -i i=$1
        if [[ -n "${stage_sed[i]}" ]]; then
            sed -e "${stage_sed[i]}" \
                | _op "${passthrough[@]}" inject $force --account "${stage_ids[i]}"
        else
            _op "${passthrough[@]}" inject $force --account "${stage_ids[i]}"
        fi
    }

    # Every pass in turn, each a $( ) over the previous result, so a failing
    # pass names its account. Prints the result.
    _op_multi_inject_loop() {
        local cur
        local -i i
        cur=$(_op_multi_inject_input)
        for (( i = 1; i <= ${#stage_acct}; i++ )); do
            cur=$(print -rn -- "$cur" | _op_multi_inject_pass $i) || {
                zdot_error "op_multi_inject: pass $i (account '${stage_acct[i]}') failed — see error above"
                return 1
            }
        done
        print -rn -- "$cur"
    }

    {
        local -a passthrough=() explicit_passes=()
        local in_file="" out_file="" default_account="" force="" arg

        # ── argparse ────────────────────────────────────────────────────────────
        while (( $# )); do
            arg=$1; shift
            case "$arg" in
                --)
                    passthrough+=("$@")
                    break
                    ;;
                -i|--input_file|--input-file)
                    [[ -n "${1:-}" ]] || { zdot_error "op_multi_inject: $arg requires a value"; return 1 }
                    in_file=$1; shift ;;
                -o|--output_file|--output-file)
                    [[ -n "${1:-}" ]] || { zdot_error "op_multi_inject: $arg requires a value"; return 1 }
                    out_file=$1; shift ;;
                --default-account)
                    [[ -n "${1:-}" ]] || { zdot_error "op_multi_inject: $arg requires a value"; return 1 }
                    default_account=$1; shift ;;
                --account)
                    [[ -n "${1:-}" ]] || { zdot_error "op_multi_inject: $arg requires a value"; return 1 }
                    explicit_passes+=("$1"); shift ;;
                --force)
                    force="--force" ;;
                --input_file=*|--input-file=*)
                    in_file=${arg#*=} ;;
                --output_file=*|--output-file=*)
                    out_file=${arg#*=} ;;
                --default-account=*)
                    default_account=${arg#*=} ;;
                --account=*)
                    explicit_passes+=("${arg#*=}") ;;
                *)
                    passthrough+=("$arg") ;;
            esac
        done

        # ── scan input: tags + raw refs ─────────────────────────────────────────
        local -i has_raw=0
        local -a derived
        local ref content=""
        if [[ -n "$in_file" ]]; then
            [[ -r "$in_file" ]] || { zdot_error "op_multi_inject: input not readable: $in_file"; return 1 }
            for ref in "${(f)$(grep -ohE 'op-[A-Za-z0-9._-]+://' "$in_file" 2>/dev/null | sort -u)}"; do
                [[ -n "$ref" ]] || continue   # empty grep output → EMPTY (f)-element, not an account
                derived+=("${${ref#op-}%://}")
            done
            grep -qE '(^|[^-])op://' "$in_file" 2>/dev/null && has_raw=1
        else
            content=$(cat)
            for ref in "${(f)$(printf '%s' "$content" | grep -ohE 'op-[A-Za-z0-9._-]+://' | sort -u)}"; do
                [[ -n "$ref" ]] || continue   # empty grep output → EMPTY (f)-element, not an account
                derived+=("${${ref#op-}%://}")
            done
            printf '%s' "$content" | grep -qE '(^|[^-])op://' && has_raw=1
        fi
        if [[ -z "$in_file" && -z "$content" ]]; then
            zdot_error "op_multi_inject: empty input"
            return 1
        fi

        # ── pass list: raw pass first, then tags (derived or explicit) ──────────
        # stage_acct keeps the SHORTNAME (tag/message); stage_ids the resolved
        # identifier op actually targets (--account accepts addresses etc; the
        # shortname→identifier map comes from secrets' _op_account_arg).
        local -a stage_acct stage_sed stage_ids
        if (( has_raw )); then
            [[ -n "$default_account" ]] || {
                zdot_error "op_multi_inject: raw op:// ref present — pass --default-account <acct> (or tag every ref as op-<account>://)"
                return 1
            }
            stage_acct+=("$default_account")
            _op_account_arg "$default_account" && stage_ids+=("$REPLY")
            stage_sed+=("")
        fi
        if (( ${#explicit_passes} > 0 )); then
            local pass_acct pass_id
            for pass_acct in "${explicit_passes[@]}"; do
                _op_account_arg "$pass_acct" && pass_id=$REPLY
                stage_acct+=("$pass_acct")
                stage_ids+=("$pass_id")
                stage_sed+=("s@op-${pass_acct}://@op://@g")
            done
        else
            for pass_acct in "${derived[@]}"; do
                _op_account_arg "$pass_acct" && pass_id=$REPLY
                stage_acct+=("$pass_acct")
                stage_ids+=("$pass_id")
                stage_sed+=("s@op-${pass_acct}://@op://@g")
            done
        fi

        # Nothing to do (no refs at all): passthrough copy, like op inject
        if (( ${#stage_acct} == 0 )); then
            if [[ -n "$out_file" ]]; then
                if [[ -n "$in_file" ]]; then
                    print -r -- "$(cat "$in_file")" > "$out_file"
                else
                    print -r -- "$content" > "$out_file"
                fi
            else
                [[ -n "$in_file" ]] && cat "$in_file" || print -r -- "$content"
            fi
            return 0
        fi

        # ── viability pre-check (all-or-nothing) ────────────────────────────────
        # Lazy mode: run the deferred session check here, with its warning
        # visible, before the per-account probes (which discard their output).
        _op_ensure_session || return 1
        local acct
        local -i i
        for (( i = 1; i <= ${#stage_acct}; i++ )); do
            acct=${stage_acct[i]}
            _op_noauth "${passthrough[@]}" whoami --account "${stage_ids[i]}" &> /dev/null || {
                zdot_error "op_multi_inject: account '$acct' is not signed in — run: op signin --account ${stage_ids[i]} (or op_identity)"
                return 1
            }
        done

        # ── passes ───────────────────────────────────────────────────────────────
        # One or two passes (the usual case): a single pipeline, nothing held
        # between passes. Three or more: a loop, each pass a $( ) over the
        # previous result. All-or-nothing either way, so the final result is
        # captured before anything is written.
        local resolved
        case ${#stage_acct} in
            1)  resolved=$(_op_multi_inject_input | _op_multi_inject_pass 1) \
                    || { zdot_error "op_multi_inject: pass 1 (account '${stage_acct[1]}') failed — see error above"; return 1 } ;;
            2)  if ! resolved=$(_op_multi_inject_input | _op_multi_inject_pass 1 \
                        | _op_multi_inject_pass 2 2>/dev/null); then
                    # The pipeline can't say which pass failed; the loop can, and
                    # shows op's error. Inject has no side effects, so re-running
                    # is safe.
                    resolved=$(_op_multi_inject_loop) || return 1
                fi ;;
            *)  resolved=$(_op_multi_inject_loop) || return 1 ;;
        esac

        [[ -n "$resolved" ]] || {
            zdot_error "op_multi_inject: empty result (empty template?)"
            return 1
        }

        # Single write path for both modes (sourcing is the CALLER's job)
        if [[ -n "$out_file" ]]; then
            print -r -- "$resolved" > "$out_file"
        else
            print -r -- "$resolved"
        fi
        return 0
    } always {
        unfunction _op_multi_inject_input _op_multi_inject_pass \
            _op_multi_inject_loop 2>/dev/null
    }
}
