#!/usr/bin/env zsh
# Check a secrets template — or an inject's OUTPUT — WITHOUT calling op: no
# sign-in, no Touch ID. Run it by hand on a template you've edited.
# op_inject_template runs it on each regen's output (<out>.tmp, before it
# replaces <out>; a failing one goes to <out>.failed): any op-looking ref
# left there is one op didn't resolve (— not a secret, so safe to print),
# and the JSON check sees what was actually written. (op_multi_inject resolves every op-<acct>:// tag or fails, so
# only look-alike schemes — opwss://… — can survive into an output.)
#
# Reference syntax (what this accepts):
#   op://<vault>/<item>/[<section>/]<field>[?attr]        raw — resolves in
#       ':zdot:secrets:op default-account' (required once >1 account is
#       configured in login-accounts)
#   op-<acct>://<vault>/<item>/[<section>/]<field>[?attr] tagged — <acct> is
#       a login-accounts shortname (e.g. op-allenai://Employee/Item/field)
#
# Reports EVERY problem as <source>:<line>: <what> — <fix>, then rc 1:
#   - op-looking scheme that is neither (opws://, op_allenai://, opw://…)
#   - tag whose account is not in login-accounts (when that is configured)
#   - raw op:// with several accounts configured and no default-account
#   - wrong path shape (fewer than 3 or more than 4 segments, empty segment)
#   - *.json: invalid JSON (via jq, when installed)
#
# <source> (default: <file>) is the file named in messages and whose name
# picks the format check — pass the template when <file> is its inject
# output. Refs are one line, so line numbers carry over.
#
# Usage: op_check_template <file> [<source>]
#        rc 0 clean, 1 problems (reported)

function op_check_template {
    local template=$1 source=${2:-$1}
    [[ -r "$template" ]] || { zdot_error "op_check_template: not readable: $template"; return 1 }

    local -a accounts problems
    _op_get_login_accounts; accounts=("${reply[@]}")
    local default_account
    zstyle -s ':zdot:secrets:op' default-account default_account

    local hint="use op://vault/item/field"
    [[ -n "$default_account" ]] && hint+=" (account '$default_account')"
    (( ${#accounts} )) && hint+=" or op-<acct>://… with <acct> one of: ${accounts[*]}"

    # Candidate refs: "op" at a word start, any scheme-ish run, then "://".
    # Value ends at a quote, backtick or template brace; trailing space trimmed.
    local hit lineno ref scheme acct refpath
    local -a segs
    for hit in "${(f)$(grep -noE '(^|[^A-Za-z0-9_])op[A-Za-z0-9._-]*://[^"'\''`{}]*' "$template")}"; do
        [[ -n "$hit" ]] || continue
        lineno=${hit%%:*}
        ref=${hit#*:}
        ref=${ref#${ref%%op*}}                 # drop the leading boundary char
        ref=${ref%%[[:space:]]#}               # trailing whitespace
        scheme=${ref%%://*}
        refpath=${ref#*://}

        case "$scheme" in
            op) acct="" ;;
            op-?*)
                acct=${scheme#op-}
                if (( ${#accounts} )) && (( ! ${accounts[(Ie)$acct]} )); then
                    problems+=("${source}:${lineno}: '${scheme}://' — '$acct' is not in login-accounts (${accounts[*]})")
                    continue
                fi ;;
            *)
                problems+=("${source}:${lineno}: unknown scheme '${scheme}://' — op inject leaves it unresolved; $hint")
                continue ;;
        esac

        if [[ "$scheme" == op ]] && (( ${#accounts} > 1 )) && [[ -z "$default_account" ]]; then
            problems+=("${source}:${lineno}: raw op:// with ${#accounts} accounts and no default-account — tag it op-<acct>:// or set zstyle ':zdot:secrets:op' default-account")
        fi

        segs=("${(@s:/:)${refpath%%\?*}}")
        if (( ${#segs} < 3 || ${#segs} > 4 )) || (( ${segs[(Ie)]} )); then
            problems+=("${source}:${lineno}: malformed ref '${ref}' — want ${scheme}://vault/item/[section/]field")
        fi
    done

    if [[ "$source" == *.json ]] && (( $+commands[jq] )); then
        local jq_err
        jq_err=$(jq empty "$template" 2>&1) \
            || problems+=("${source}: invalid JSON — ${jq_err//$'\n'/ }")
    fi

    (( ${#problems} )) || return 0
    zdot_error "secrets: ${#problems} problem(s) in ${source:t}:"
    local p
    for p in "${problems[@]}"; do zdot_error "  $p"; done
    return 1
}
