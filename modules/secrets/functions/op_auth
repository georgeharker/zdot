#!/usr/bin/env zsh
# Sign in to 1Password (interactive only). What that means depends on the
# auth mode (zstyle ':zdot:secrets:op' mode):
#
#   login / lazy-login — sign PEOPLE in: every login-accounts entry, or the
#     one named, or the default account when login-accounts is unset.
#     Names resolve via ':zdot:secrets:op:<name>' account-url.
#   service-account — nobody to sign in: the identity is the service-account
#     token, good for the whole session. op_auth uses it when it works
#     (loading it from the cache if this shell doesn't have it). It does NOT
#     create one: with no working token it errors and points at op_identity,
#     which creates or chooses the service account.
#
# Usage:
#   op_auth [--reset|-r] [<acct>]
#     --reset — clean slate: delete the token cache and the secrets cache,
#       unset OP_SERVICE_ACCOUNT_TOKEN, `op account forget` everything (or
#       just <acct>), then sign in again (login modes) or point at
#       op_identity (service-account).
#
# Returns 0 when signed in / the token works, 1 otherwise.

function op_auth {
    [[ $_ZDOT_IS_INTERACTIVE -eq 1 ]] || return 1

    # ── argparse (light): --reset/-r flag; first positional = account ──────
    local -a positional=()
    local reset_flag="" arg
    for arg in "$@"; do
        case "$arg" in
            --reset|-r) reset_flag=1 ;;
            *) positional+=("$arg") ;;
        esac
    done
    local account=${positional[1]:-}

    if [[ -n "$reset_flag" ]]; then
        # Drop the cached service key + materialised secrets (the templates
        # under $XDG_CONFIG_HOME/secrets stay — those are refs, not secrets)
        typeset -A _se
        _op_get_secrets_env && _se=("${reply[@]}")
        rm -f "${_se[cache]}/${USER}.op-secrets.zsh" "${_se[cache]}/${USER}.secrets.zsh"
        unset OP_SERVICE_ACCOUNT_TOKEN
        # Forget: the targeted account, or everything the CLI knows (--all)
        local forget_target="${account:---all}"
        printf "1Password: forgetting %s accounts" "$forget_target"
        if _op_noauth account forget "$forget_target" 2>/dev/null; then
            echo "; forgotten"
        else
            echo "; not forgotten (may be app-integration managed)"
        fi
    fi

    # ── service-account: use the token, never create one ────────────────────
    if ! _op_is_login; then
        if [[ -z "$reset_flag" ]] && _op_sa_token_ok; then
            echo "1Password: using the service-account token"
            _ZDOT_OP_ACTIVE=1
            return 0
        fi
        zdot_error "secrets: no working 1Password service-account token — run op_identity to create or choose one"
        return 1
    fi

    # ── login modes: sign people in ─────────────────────────────────────────
    if [[ -z "$account" ]]; then
        local -a accounts
        _op_get_login_accounts
        accounts=("${reply[@]}")
        if (( ${#accounts} > 0 )); then
            local ac rc=0
            for ac in "${accounts[@]}"; do
                _op_auth_person "$ac" || rc=1
            done
            return $rc
        fi
    fi
    _op_auth_person "$account"
}
