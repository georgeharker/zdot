#!/usr/bin/env zsh
# Authenticate with 1Password (interactive only).
# Ensures signed-in sessions for the configured accounts.
#
# Usage:
#   op_auth [--reset|-r] [<acct>]
#     --reset — remove the cached service key (SA-token cache + injected
#       env caches; unsets OP_SERVICE_ACCOUNT_TOKEN) and `op account forget`
#       everything (or just <acct>), then continue into a fresh sign-in —
#       a clean-slate restart.
#   op_auth [<acct>] — one explicit account: targeted check + signin
#   op_auth          — with ':zdot:secrets:op login-accounts' set: walks
#                      EVERY listed account (targeted whoami + signin) so
#                      all configured accounts end up logged in; without
#                      that zstyle: legacy bare flow (default account)
#
# Account identifiers are the shorthands from `op account list` (the tag
# vocabulary used in the op-<acct>:// template refs). `--account` also
# accepts email / address / UUID, so a tag using any of those resolves.
#
# Sets up op configuration and ensures the user is signed in.
# Returns 0 on success, 1 on failure or user cancellation.

function op_auth {
    # Only run in interactive shells
    if [[ $_ZDOT_IS_INTERACTIVE -ne 1 ]]; then
        return 1
    fi

    # ── argparse (light): --reset/-r flag; first positional = account ──────
    local -a positional=()
    local reset_flag="" arg
    for arg in "$@"; do
        case "$arg" in
            --reset|-r) reset_flag=1 ;;
            *) positional+=("$arg") ;;
        esac
    done
    local account=${positional[1]:-}

    local op_config_dir
    op_config_dir=$(op_get_config_dir)

    if [[ -n "$reset_flag" ]]; then
        # Drop the cached service key + materialised secrets (the templates
        # under $XDG_CONFIG_HOME/secrets stay — those are refs, not secrets)
        typeset -A _se
        _op_get_secrets_env && _se=("${reply[@]}")
        rm -f "${_se[cache]}/${USER}.op-secrets.zsh" "${_se[cache]}/${USER}.secrets.zsh"
        unset OP_SERVICE_ACCOUNT_TOKEN
        # Forget: the targeted account, or everything the CLI knows (--all)
        local forget_target="${account:---all}"
        printf "1Password: forgetting %s accounts" "$forget_target"
        if _op account forget "$forget_target" 2>/dev/null; then
            echo "; forgotten"
        else
            echo "; not forgotten (may be app-integration managed)"
        fi
    fi

    # No account arg + configured accounts: ensure ALL of them (recurse,
    # without re-resetting)
    if [[ -z "$account" ]]; then
        local -a accounts
        _op_get_login_accounts
        accounts=("${reply[@]}")
        if (( ${#accounts} > 0 )); then
            local ac rc=0
            for ac in "${accounts[@]}"; do
                op_auth "$ac" || rc=1
            done
            return $rc
        fi
    fi

    # Check if no_op flag is set
    if [[ -f "${op_config_dir}/no_op" ]]; then
        return 1
    fi

    # If config doesn't exist, prompt to set up
    if [[ ! -f "${op_config_dir}/config" ]]; then
        printf "Set up 1Password? [Y/n/c] "
        read -r -k 1 option
        [[ "$option" = $'\n' ]] || echo
        case "$option" in
            [yY$'\n']) ;;
            [nN])
                mkdir -p "${op_config_dir}"
                touch "${op_config_dir}/no_op"
                return 1
                ;;
            *)
                echo "You will be asked at next login"
                return 1
                ;;
        esac
    fi

    # Ensure signed in (to the requested account when given). Announce by
    # shortname before prompting; _op_signin resolves the name, evals the
    # session and confirms it with whoami.
    _op_logged_in "$account" && return 0
    printf "Signing into 1Password: %s\n" "${account:-default account}"
    _op_signin "$account" && return 0
    echo "1Password: sign-in did not take for '${account:-default}'"
    if [[ -n "$account" ]]; then
        _op_account_arg "$account"
        if [[ "$REPLY" == "$account" ]]; then
            echo "  '$account' is not a CLI shorthand — map it:"
            echo "    zstyle ':zdot:secrets:op:$account' account-url <address|email|uuid>"
        fi
    fi
    return 1
}