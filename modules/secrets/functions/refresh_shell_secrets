#!/usr/bin/env zsh
# Refresh shell secrets from 1Password
# Requires _ZDOT_OP_ACTIVE=1 (op authenticated; either auth mode)
#
# Template routing (and auth-mode nuance) lives in op_inject_template:
# tagged (op-<acct>://) → op_multi_inject; plain → single inject. This
# caller only resolves paths and sources the result.

function refresh_shell_secrets {
    [[ $_ZDOT_OP_ACTIVE -ne 1 ]] && return 1

    # Secrets environment — one resolver, named keys (see secrets.zsh)
    typeset -A _se
    _op_get_secrets_env && _se=("${reply[@]}")
    local secrets_src_dir="${_se[src_dir]}" secrets_cache="${_se[cache]}" \
        op_secrets_profile_suffix="${_se[suffix]}"

    local template="${secrets_src_dir}/secrets${op_secrets_profile_suffix}.zsh"
    local cache_out="${secrets_cache}/${USER}.secrets.zsh"

    op_inject_template "$template" "$cache_out" || return 1
    [[ -f "$cache_out" ]] && source "$cache_out"
    return 0
}