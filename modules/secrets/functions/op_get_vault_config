#!/usr/bin/env zsh
# Read 1Password vault configuration from zstyle with defaults.
#
# Returns a flat NAME/VALUE pair list in $reply (scalars only; the grants ARRAY
# is a separate return — see op_get_vault_grants — kept disentangled so each
# function owns exactly one return channel):
#   svc - vault storing service account credentials (zstyle service-acct-vault)
#   api - vault for API keys / tokens (zstyle api-vault)
#   ssh - vault for SSH keys (zstyle ssh-vault)
#
# zstyle API (set in a secrets-configure group hook):
#   zstyle ':zdot:secrets:op' service-acct-vault 'ServiceAcct'
#   zstyle ':zdot:secrets:op' api-vault          'API'
#   zstyle ':zdot:secrets:op' ssh-vault          'SSHKeys'
#
# Consumer (typeset -A _v declared at consumer scope; capture immediately):
#   typeset -A _v
#   op_get_vault_config && _v=("${reply[@]}")
#   local op_svc_vault="${_v[svc]}" op_api_vault="${_v[api]}" \
#       op_ssh_vault="${_v[ssh]}"

function op_get_vault_config {
    local op_svc op_api op_ssh
    zstyle -s ':zdot:secrets:op' service-acct-vault op_svc \
        || op_svc='ServiceAcct'
    zstyle -s ':zdot:secrets:op' api-vault op_api \
        || op_api='API'
    zstyle -s ':zdot:secrets:op' ssh-vault op_ssh \
        || op_ssh='SSHKeys'
    reply=(
        svc "$op_svc"
        api "$op_api"
        ssh "$op_ssh"
    )
}