#!/usr/bin/env zsh
# Show per-hook execution status from the last zdot startup.
# Usage: zdot_hooks_status [--timing|-t]
#   --timing, -t   append each hook's measured body time and print a timing
#                  summary (pass totals + slowest hooks)
#
# Requires zdot_execute_all to have run (i.e. after shell startup).
# Shows each hook in plan order annotated with:
#   [ok]                ran successfully
#   [skipped: tool]     runtime gate: a --requires-optional-tool is not on PATH
#   [skipped: cascade]  runtime gate: a required phase's provider was skipped/failed
#   [failed: rc=N]      ran but returned non-zero
#   [not found]         function was missing at execution time
#   [not run]           in plan but never attempted
#
# Summary is per pass. Gate skips are deliberate, not failures. An un-run
# deferred hook is "pending" until the deferred drain finishes (or forever in a
# non-ZLE shell, where it never starts); once the drain HAS finished, un-run
# deferred hooks are "not run (drain stalled)" and count as a failure.
#
# Returns 1 if any hook failed, an eager hook didn't run, or the drain stalled.

function zdot_hooks_status() {
    local timing=0 arg
    for arg in "$@"; do
        case "$arg" in
            --timing|-t) timing=1 ;;
        esac
    done

    if (( ${#_ZDOT_EXECUTION_PLAN[@]} == 0 \
        && ${#_ZDOT_EXECUTION_PLAN_DEFERRED[@]} == 0 )); then
        zdot_warn "No execution plan found — has zdot_init been called?"
        return 1
    fi

    local _ok=0 _skipped=0 _failed=0 _notrun=0          # eager
    local _d_ok=0 _d_skipped=0 _d_failed=0 _d_notrun=0  # deferred
    # _ZDOT_DEFER_WALL_MS is set once the deferred drain completes or stalls.
    local _drain_done=0
    [[ -n ${_ZDOT_DEFER_WALL_MS:-} ]] && _drain_done=1

    zdot_report "Hook execution status:"
    zdot_info ""

    # Eager plan
    if (( ${#_ZDOT_EXECUTION_PLAN[@]} > 0 )); then
        zdot_info "  Eager:"
        local _pos=1
        for hook_id in "${_ZDOT_EXECUTION_PLAN[@]}"; do
            # The plan holds deferred ids too; they're listed under Deferred.
            (( ${_ZDOT_EXECUTION_PLAN_DEFERRED[(Ie)$hook_id]} )) && continue
            local func="${_ZDOT_HOOKS[$hook_id]}"
            _zdot_hook_display_marks "$hook_id" "$func"
            typeset -A _mk
            _mk=("${reply[@]}")
            (( timing )) || _mk[time]=""
            zdot_info "    [$_pos] $func${_mk[status]}${_mk[time]}"
            local _rc="${_ZDOT_HOOKS_EXEC_RESULT[$hook_id]:-}"
            if [[ -z "$_rc" ]]; then
                (( _notrun++ ))
            elif [[ "$_rc" == skipped-* ]]; then
                (( _skipped++ ))
            elif [[ "$_rc" != '0' ]]; then
                (( _failed++ ))
            else
                (( _ok++ ))
            fi
            (( _pos++ ))
        done
        zdot_info ""
    fi

    # Deferred plan
    if (( ${#_ZDOT_EXECUTION_PLAN_DEFERRED[@]} > 0 )); then
        zdot_info "  Deferred:"
        local _pos=1
        for hook_id in "${_ZDOT_EXECUTION_PLAN_DEFERRED[@]}"; do
            local func="${_ZDOT_HOOKS[$hook_id]}"
            _zdot_hook_display_marks "$hook_id" "$func"
            typeset -A _mk
            _mk=("${reply[@]}")
            (( timing )) || _mk[time]=""
            zdot_info "    [$_pos] $func${_mk[status]}${_mk[time]}"
            local _rc="${_ZDOT_HOOKS_EXEC_RESULT[$hook_id]:-}"
            if [[ -z "$_rc" ]]; then
                (( _d_notrun++ ))   # pending or stalled — decided by _drain_done
            elif [[ "$_rc" == skipped-* ]]; then
                (( _d_skipped++ ))
            elif [[ "$_rc" != '0' ]]; then
                (( _d_failed++ ))
            else
                (( _d_ok++ ))
            fi
            (( _pos++ ))
        done
        zdot_info ""
    fi

    # Summary
    zdot_info "  Eager:    ${_ok} ok, ${_skipped} skipped, ${_failed} failed, ${_notrun} not run"
    if (( ${#_ZDOT_EXECUTION_PLAN_DEFERRED[@]} > 0 )); then
        local _d_word="pending"
        (( _drain_done )) && _d_word="not run (drain stalled)"
        zdot_info "  Deferred: ${_d_ok} ok, ${_d_skipped} skipped, ${_d_failed} failed, ${_d_notrun} ${_d_word}"
    fi
    zdot_info ""

    if (( timing )); then
        _zdot_timing_summary
        zdot_info ""
    fi

    local _stalled=0
    (( _drain_done )) && _stalled=$_d_notrun
    return $(( _failed + _d_failed + _notrun + _stalled > 0 ))
}
