#!/usr/bin/env zsh
# zdot_update_plugin: Update one, several, or all plugin(s) via git pull.
# Bundle-aware via zdot_plugin_repo: specs sharing one backing repo collapse
# to a single fetch/pull.

zdot_update_plugin() {
    emulate -L zsh
    local all=0
    local -a specs
    if (( $# )); then
        specs=( "$@" )
    else
        zdot_info "Updating all declared plugins..."
        all=1
    fi

    # Selection + @ver parse + backing-repo resolution + dedupe-by-repo is shared
    # with reclone/clean via _zdot_plugins_resolve_targets. It sets index-aligned
    # _zdot_rt_* arrays (bare/version/dir/label/spec/bundle) plus REPLY = the count
    # of specs whose bundle exposes no repo — which used to be counted here as
    # failures, so seed `failed` with it. (update pulls the whole backing repo for
    # a bundle spec by design, so it ignores the _zdot_rt_bundle flag.)
    _zdot_plugins_resolve_targets "$all" "${specs[@]}"
    local -a t_version=( "${_zdot_rt_version[@]}" )  # shuck: ignore=C006  # set by _zdot_plugins_resolve_targets
    local -a t_dir=( "${_zdot_rt_dir[@]}" )          # shuck: ignore=C006
    local -a t_label=( "${_zdot_rt_label[@]}" )      # shuck: ignore=C006

    local version repo_dir label cur_branch default_ref
    local before after short_before short_after commit_count
    local updated=0 unchanged=0 failed=$REPLY
    integer i

    for (( i = 1; i <= ${#t_dir}; i++ )); do
        version=${t_version[i]}
        repo_dir=${t_dir[i]}
        label=${t_label[i]}

        if [[ ! -d "$repo_dir" ]]; then
            zdot_error "  $label: not installed"
            (( failed++ ))
            continue
        fi

        if [[ ! -d "$repo_dir/.git" ]]; then
            zdot_error "  $label: not a git repo"
            (( failed++ ))
            continue
        fi

        before=$(cd "$repo_dir" && command git rev-parse HEAD 2>/dev/null)

        if [[ -n "$version" ]]; then
            zdot_action "  Checking out $version for $label..."
            if (cd "$repo_dir" && command git fetch --quiet && command git checkout --quiet "$version") 2>/dev/null; then
                _zdot_plugin_sync_submodules "$label" "$repo_dir"
                after=$(cd "$repo_dir" && command git rev-parse HEAD 2>/dev/null)
                if [[ "$before" == "$after" ]]; then
                    zdot_info "    %F{244}already at $version%f"
                    (( unchanged++ ))
                else
                    short_before=${before[1,7]}
                    short_after=${after[1,7]}
                    zdot_success "    checked out $version ($short_before → $short_after)"
                    _zdot_update_plugin_show_changelog "$repo_dir" "$before" "$after"
                    (( updated++ ))
                fi
            else
                zdot_error "    $label@$version failed"
                (( failed++ ))
            fi
            continue
        fi

        # Heal unpinned drift: put the clone back on the remote's default
        # branch before pulling. The startup reconcile (zdot_plugin_clone) is
        # edge-triggered and can miss a flip, leaving the clone stranded so the
        # pull below would track the wrong branch; an explicit update is the
        # right place to catch it without taxing every shell startup.
        if _zdot_plugin_default_ref "$repo_dir"; then
            default_ref=$REPLY
            cur_branch=$(cd "$repo_dir" && command git symbolic-ref --quiet --short HEAD 2>/dev/null)
            # Mismatch covers both "on the wrong branch" and "detached HEAD".
            if [[ "$cur_branch" != "$default_ref" ]]; then
                if _zdot_plugin_restore_default_branch "$label" "$repo_dir"; then
                    before=$(cd "$repo_dir" && command git rev-parse HEAD 2>/dev/null)
                fi
            fi
        fi

        zdot_action "  Updating $label..."
        if (cd "$repo_dir" && command git pull --quiet) 2>/dev/null; then
            _zdot_plugin_sync_submodules "$label" "$repo_dir"
            after=$(cd "$repo_dir" && command git rev-parse HEAD 2>/dev/null)
            if [[ "$before" == "$after" ]]; then
                zdot_info "    %F{244}already up to date%f"
                (( unchanged++ ))
            else
                short_before=${before[1,7]}
                short_after=${after[1,7]}
                commit_count=$(cd "$repo_dir" && command git rev-list --count "$before..$after" 2>/dev/null)
                zdot_success "    updated ($short_before → $short_after, ${commit_count:-?} commit$( (( commit_count == 1 )) || print s ))"
                _zdot_update_plugin_show_changelog "$repo_dir" "$before" "$after"
                (( updated++ ))
            fi
        else
            zdot_error "    failed"
            (( failed++ ))
        fi
    done

    if (( updated == 0 && unchanged == 0 && failed == 0 )); then
        zdot_info "No plugins to update"
    else
        zdot_info "Done ($updated updated, $unchanged already up to date, $failed failed)"
    fi
}

# Print up to 3 commit subjects between $2 and $3 in $1, indented and faded.
# Silent on any git error or empty range — purely cosmetic.
_zdot_update_plugin_show_changelog() {
    local repo=$1 from=$2 to=$3
    local -a subjects
    subjects=( "${(@f)$(cd "$repo" && command git log --no-merges --pretty=format:'%s' "$from..$to" 2>/dev/null)}" )
    subjects=( ${subjects:#} )
    (( ${#subjects} )) || return 0
    local subj
    local shown=0
    for subj in "${subjects[@]}"; do
        (( shown >= 3 )) && break
        zdot_info "      %F{244}• ${subj//\%/%%}%f"
        (( shown++ ))
    done
    if (( ${#subjects} > shown )); then
        zdot_info "      %F{244}… and $(( ${#subjects} - shown )) more%f"
    fi
}

# autoload -Uz uses ZSH style when the file contains more than one top-level
# definition: the file's body becomes the function body, defining everything
# but never calling the named function. Trailing call re-dispatches so the
# first invocation actually runs the update.
zdot_update_plugin "$@"
